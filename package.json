{
  "name": "flowdesk-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FlowDesk: Internal WhatsApp Automation Platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,CLIENT\" -c \"blue.bold,green.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:all": "concurrently -n \"API,WORKER,CLIENT\" -c \"blue.bold,magenta.bold,green.bold\" \"npm run dev:backend\" \"npm run dev:worker\" \"npm run dev:frontend\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "seed": "npm --workspace=backend run seed",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:worker": "npm --workspace=backend run dev:worker",
    "dev:frontend": "npm --workspace=frontend run dev",
    "test:backend": "npm --workspace=backend run test",
    "test:coverage": "npm --workspace=backend run test:coverage",
    "build:backend": "npm --workspace=backend run build",
    "build:frontend": "npm --workspace=frontend run build"
  },
  "keywords": [
    "whatsapp",
    "automation",
    "recruitment",
    "workflow"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
