# -----------------------------------------------------------------------------
# FlowDesk Environment Configuration Reference
# -----------------------------------------------------------------------------

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Persistence (MongoDB)
MONGODB_URI=mongodb://localhost:27017/flowdesk

# In-Memory Cache and Background Queues (Redis)
REDIS_URL=redis://localhost:6379

# Authentication (JWT)
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_min_32_characters_long
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_min_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Messaging Provider ("mock" or "meta")
MESSAGING_PROVIDER=mock

# Meta WhatsApp Cloud API (Required only when MESSAGING_PROVIDER=meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_random_verify_token
WHATSAPP_APP_SECRET=

# AI Provider ("mock", "gemini", or "openai")
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-2.0-flash

# Microsoft Graph API / Excel Online Integration
MS_GRAPH_MOCK_MODE=true
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_DRIVE_ID=
MS_GRAPH_WORKBOOK_ITEM_ID=
MS_GRAPH_WORKSHEET_NAME=Responses

# External Verification Provider ("mock", "google_sheets", "microsoft_graph", or "internal_db")
VERIFICATION_PROVIDER=mock
VERIFICATION_MOCK_MODE=true

# Google Sheets Integration (Required when VERIFICATION_PROVIDER=google_sheets)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Responses
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_API_KEY=

# Rate Limiting & Queue Dispatch Pacing
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
OUTBOUND_DISPATCH_RATE_PER_SEC=20

